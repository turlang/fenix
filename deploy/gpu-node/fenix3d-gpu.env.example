# Fênix GPU Node — exemplo de configuração (Windows + UE5.5 + Pixel Streaming 2)
# Copie para um arquivo local fora do Git e substitua os valores CHANGE_ME.

FENIX_RENDER_NODE_HOST=0.0.0.0
FENIX_RENDER_NODE_PORT=9000
FENIX_RENDER_NODE_ID=gpu-render-01
FENIX_RENDER_NODE_REGION=br-south
FENIX_RENDER_NODE_TOKEN=CHANGE_ME_USE_32_PLUS_RANDOM_CHARS
FENIX_RENDER_NODE_CAPACITY=1
FENIX_RENDER_SESSION_TTL_MS=1800000
FENIX_RENDER_NODE_PUBLIC_HEALTH=false

# Runtime Unreal empacotado.
FENIX_RENDER_RUNTIME_MODE=process
FENIX_RENDER_RUNTIME_COMMAND=C:\Fenix\Runtime\Fenix3D.exe
FENIX_RENDER_RUNTIME_CWD=C:\Fenix\Runtime
FENIX_RENDER_RUNTIME_BOOTSTRAP_BASE_URL=http://127.0.0.1:9000
FENIX_RENDER_RUNTIME_STARTUP_GRACE_MS=1500
FENIX_RENDER_RUNTIME_STOP_TIMEOUT_MS=5000

# Unreal -> Signalling. O launcher adiciona -PixelStreamingID=<renderSessionId>.
FENIX_RENDER_STREAMER_URL_TEMPLATE=ws://127.0.0.1:8888

# Browser -> frontend/signalling. Ajuste a query ao frontend Pixel Streaming implantado.
FENIX_RENDER_PLAYER_URL_TEMPLATE=https://stream.example.com/?streamerId={renderSessionId}
FENIX_RENDER_SIGNALLING_URL_TEMPLATE=wss://stream.example.com/

# Readiness HTTP/HTTPS antes de o Render Node declarar a sessão pronta.
# Pode apontar para o frontend, reverse proxy ou endpoint customizado do stack.
FENIX_RENDER_RUNTIME_READY_URL_TEMPLATE=https://stream.example.com/?streamerId={renderSessionId}
FENIX_RENDER_RUNTIME_READY_TIMEOUT_MS=15000
FENIX_RENDER_RUNTIME_READY_INTERVAL_MS=500

# Argumentos adicionais permanecem exclusivamente no servidor.
FENIX_RENDER_RUNTIME_EXTRA_ARGS_JSON=["-AudioMixer"]

# Build/package e infraestrutura usados pelos scripts de manutenção do GPU Node.
FENIX_UNREAL_ENGINE_ROOT=C:\Program Files\Epic Games\UE_5.5
FENIX_UNREAL_ARCHIVE_DIR=C:\Fenix\Builds\Fenix3D
FENIX_PIXEL_STREAMING_INFRA_ROOT=C:\Fenix\PixelStreamingInfrastructure

# A infraestrutura Pixel Streaming deve usar a branch compatível com UE5.5.
# Configure ICE/STUN/TURN no SignallingWebServer conforme a topologia da hospedagem.
