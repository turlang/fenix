{
  "name": "mestre-orc-engine",
  "version": "0.1.0-alpha.24",
  "description": "Fênix Shared Core para narração, Foundry VTT e cliente VTT standalone.",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node apps/api/src/server.js",
    "start": "node apps/api/src/server.js",
    "dev:vtt": "npm --workspace @fenix/vtt run dev",
    "build:vtt": "npm --workspace @fenix/vtt run build",
    "test": "node --test",
    "test:realtime-integration": "node integration-tests/realtime-websocket.mjs",
    "test:auth-integration": "node integration-tests/auth-campaign-http.mjs",
    "test:postgres-integration": "node integration-tests/postgres-persistence.mjs",
    "test:coordination-integration": "node integration-tests/distributed-runtime-coordination.mjs",
    "test:routing-integration": "node integration-tests/owner-aware-runtime-routing.mjs",
    "test:idempotency-integration": "node integration-tests/distributed-command-idempotency.mjs",
    "migrate:postgres": "node scripts/migrate-fenix-json-to-postgres.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "npm run validate && npm test"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.2.1",
    "pg": "^8.22.0"
  }
}
