{
  "name": "mestre-orc-engine",
  "version": "0.1.0-alpha.37",
  "description": "Motor modular de narração cinematográfica e rodadas fora de combate para Foundry VTT com integração de IA e áudio.",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node apps/api/src/server.js",
    "start": "node apps/api/src/server.js",
    "test": "node scripts/run-tests.mjs",
    "audit": "npm audit --omit=dev",
    "validate": "node scripts/validate.mjs",
    "check:offline": "npm run validate && npm test",
    "release:prepare": "node scripts/prepare-release.mjs",
    "check": "npm run validate && npm run audit && npm test"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "license": "UNLICENSED",
  "overrides": {
    "@fastify/ajv-compiler": {
      "fast-uri": "3.1.4"
    },
    "ajv": {
      "fast-uri": "3.1.4"
    }
  },
  "dependencies": {
    "fastify": "^5.2.1"
  }
}
