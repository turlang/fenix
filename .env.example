PORT=3001
HOST=0.0.0.0
NODE_ENV=development
BODY_LIMIT_BYTES=2097152
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:30000,http://127.0.0.1:30000,http://localhost:3000,http://localhost:3001

# Persistência do Fênix.
# Sem DATABASE_URL, o desenvolvimento continua usando JSON local.
# Em produção, prefira postgres para campanhas/sessões simultâneas e persistência transacional.
FENIX_PERSISTENCE_DRIVER=json
FENIX_STATE_FILE=./data/fenix-state.json
# DATABASE_URL=postgres://usuario:senha@host:5432/fenix
# FENIX_PERSISTENCE_DRIVER=postgres
FENIX_POSTGRES_POOL_MAX=10
FENIX_POSTGRES_CONNECT_TIMEOUT_MS=5000
FENIX_POSTGRES_IDLE_TIMEOUT_MS=30000

# Assets de mapas do VTT standalone.
FENIX_ASSET_DIR=./data/fenix-assets
FENIX_ASSET_MAX_BYTES=15728640

# Importação de battlemap por URL HTTP/HTTPS.
FENIX_REMOTE_MAP_TIMEOUT_MS=10000
FENIX_REMOTE_MAP_MAX_REDIRECTS=3

# Coordenação distribuída (ativa somente com PostgreSQL).
# FENIX_INSTANCE_ID=engine-render-1
# FENIX_INSTANCE_PUBLIC_URL=https://engine-a.internal.example.com
# FENIX_INTERNAL_ROUTING_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
FENIX_RUNTIME_LEASE_TTL_MS=15000
FENIX_RUNTIME_HEARTBEAT_MS=5000
FENIX_RUNTIME_RECONCILE_MS=5000
FENIX_RUNTIME_ROUTING_TIMEOUT_MS=5000
FENIX_RUNTIME_ROUTING_MAX_RETRIES=1

# Ledger distribuído de comandos.
FENIX_COMMAND_LEDGER_WAIT_MS=1500
FENIX_COMMAND_LEDGER_UNKNOWN_AFTER_MS=60000
FENIX_COMMAND_LEDGER_RETENTION_HOURS=168
FENIX_COMMAND_LEDGER_RESULT_MAX_BYTES=524288

# Cookie HttpOnly de autenticação standalone.
FENIX_AUTH_COOKIE_SAME_SITE=Lax

# Compatibilidade do módulo Foundry/HTTP legado.
FENIX_ALLOW_LEGACY_SESSION_HTTP=true

# -----------------------------------------------------------------------------
# AI Gateway híbrido
# -----------------------------------------------------------------------------
# Políticas:
# - local-only: somente a LLM do servidor GPU; nunca envia conteúdo ao provider cloud.
# - local-preferred: tenta a LLM local e usa cloud se o node local falhar.
# - cloud-only: usa apenas provider cloud.
# Se omitido: local-preferred quando FENIX_LOCAL_LLM_* estiver configurado;
# caso contrário cloud-only para preservar o comportamento atual.
FENIX_AI_ROUTING_POLICY=local-preferred

# LLM local em servidor GPU. O endpoint deve ser OpenAI-compatible e acessível
# somente pelo App Server/rede privada. O browser nunca deve acessar esta URL.
# Exemplos de runtimes compatíveis podem usar /v1/chat/completions.
# FENIX_LOCAL_LLM_BASE_URL=http://gpu-ai.internal:8000/v1
# FENIX_LOCAL_LLM_MODEL=seu-modelo-local
# FENIX_LOCAL_LLM_API_KEY=opcional_se_o_runtime_exigir
FENIX_LOCAL_LLM_TIMEOUT_MS=60000
FENIX_LOCAL_LLM_MAX_TOKEN_FIELD=max_tokens

# Provider cloud opcional/fallback. Pode permanecer configurado durante a migração.
GROQ_API_KEY=sua_chave_aqui
GROQ_MODEL=defina_um_modelo_disponivel_na_sua_conta_groq
# GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=45000

# Histórico persistente usado pelo NoveltyGuard para evitar repetir aberturas.
MESTRE_ORC_NARRATION_MEMORY_FILE=./data/narration-history.json

# Áudio da narração.
MESTRE_ORC_AUDIO_ENABLED=true
MESTRE_ORC_AUDIO_MODE=browser-tts
MESTRE_ORC_AUDIO_LANGUAGE=pt-BR
MESTRE_ORC_AUDIO_RATE=0.92
MESTRE_ORC_AUDIO_PITCH=0.95
MESTRE_ORC_AUDIO_VOLUME=1.00
# MESTRE_ORC_AUDIO_VOICE=Microsoft Antonio - Portuguese (Brazil)

# Marcadores de emoção/prosódia.
MESTRE_ORC_AUDIO_EMOTION_MARKERS=false
