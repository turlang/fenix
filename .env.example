PORT=3001
HOST=0.0.0.0
NODE_ENV=development
BODY_LIMIT_BYTES=2097152
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:30000,http://127.0.0.1:30000,http://localhost:3000,http://localhost:3001

# Configure ao menos um provedor com chave e modelo. Sem nenhum provedor completo, o Engine retorna AI_NOT_CONFIGURED.
# Groq permanece como primeira opção no exemplo, mas não é obrigatória.
GROQ_API_KEY=
GROQ_MODEL=

# Histórico persistente usado pelo NoveltyGuard para evitar repetir aberturas.
# Opcional. Padrão: ./data/narration-history.json
MESTRE_ORC_NARRATION_MEMORY_FILE=./data/narration-history.json

# Memória persistente da campanha: fatos, NPCs, relações, missões, itens e World State.
# Opcional. Padrão: ./data/campaign-memory.json
MESTRE_ORC_CAMPAIGN_MEMORY_FILE=./data/campaign-memory.json

# Biblioteca persistente de aventuras importadas.
# Opcional. Padrão: ./data/adventure-library.json
ADVENTURE_LIBRARY_FILE=./data/adventure-library.json

# Arquivo persistente dos geradores de aventuras, NPCs e dungeons.
# Resultados são arquivados antes da ativação e comparados com o histórico para evitar repetição.
GENERATOR_ARCHIVE_FILE=./data/generated-content.json
GENERATOR_SIMILARITY_THRESHOLD=0.62
GENERATOR_MAX_ATTEMPTS=3

# Comando opcional para extração de PDF textual.
# Linux/macOS normalmente usam pdftotext; no Windows informe o caminho do executável do Poppler quando necessário.
PDFTOTEXT_COMMAND=pdftotext

# Áudio da narração. O modo browser-tts envia uma diretiva ao módulo Foundry;
# cada navegador converte o roteiro em voz, interpreta marcações expressivas e preserva pausas dramáticas.
MESTRE_ORC_AUDIO_ENABLED=true
MESTRE_ORC_AUDIO_LANGUAGE=pt-BR
MESTRE_ORC_AUDIO_RATE=0.90
MESTRE_ORC_AUDIO_PITCH=0.85
MESTRE_ORC_AUDIO_VOLUME=1.00

# Voz neural externa. Modos de áudio: browser-tts, neural-auto ou neural-only.
# neural-auto tenta a voz neural e usa SpeechSynthesis quando permitido pelo perfil.
MESTRE_ORC_AUDIO_MODE=browser-tts
MESTRE_ORC_AUDIO_SYNTHESIS_PATH=/v1/audio/synthesize
NEURAL_VOICE_ENABLED=true
VOICE_PROVIDER_ORDER=elevenlabs,openai,compatible
VOICE_PROVIDER_TIMEOUT_MS=45000
VOICE_CACHE_TTL_MS=600000
VOICE_MAX_CHARACTERS=4096
VOICE_MAX_AUDIO_BYTES=12582912

# Perfis persistentes de narrador e NPCs. Padrão: ./data/voice-profiles.json
VOICE_PROFILE_FILE=./data/voice-profiles.json

# OpenAI TTS. Usa OPENAI_API_KEY e OPENAI_BASE_URL já configurados abaixo.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_TTS_FORMAT=mp3

# ElevenLabs TTS. Configure a chave e uma voz padrão; perfis podem sobrescrever voice ID e modelo.
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_TTS_VOICE_ID=
ELEVENLABS_TTS_OUTPUT_FORMAT=mp3_44100_128

# Endpoint TTS compatível com OpenAI, inclusive servidor local.
COMPATIBLE_TTS_API_KEY=
COMPATIBLE_TTS_BASE_URL=
COMPATIBLE_TTS_MODEL=tts-1
COMPATIBLE_TTS_VOICE=alloy
COMPATIBLE_TTS_FORMAT=mp3

# Resiliência de IA. Configure dois ou mais provedores para fallback automático.
# A ordem abaixo define o primário e os fallbacks; provedores configurados e omitidos são anexados ao final.
AI_PROVIDER_ORDER=groq,openai,anthropic,compatible
AI_PROVIDER_TIMEOUT_MS=45000
AI_PROVIDER_FAILURE_THRESHOLD=3
AI_PROVIDER_COOLDOWN_MS=60000

# Groq — Chat Completions compatível com OpenAI.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI — Responses API. Configure somente quando desejar usar este provedor.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic — Messages API. Configure somente quando desejar usar este provedor.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01

# Endpoint adicional compatível com OpenAI, inclusive servidor local.
# A chave pode permanecer vazia quando o servidor não exigir autenticação.
AI_COMPATIBLE_ID=local
AI_COMPATIBLE_API_KEY=
AI_COMPATIBLE_MODEL=
AI_COMPATIBLE_BASE_URL=
AI_COMPATIBLE_MAX_TOKENS_FIELD=max_tokens

# Plantas vetoriais persistentes e geração de mapas automáticos.
# A IA planeja o grafo das áreas; o Engine calcula layout, SVG, paredes, portas, luzes e Notes.
MAP_BLUEPRINT_FILE=./data/map-blueprints.json
MAP_GENERATION_MAX_ATTEMPTS=2

# Histórico privado dos tutores, isolado por campanha.
TUTOR_HISTORY_FILE=./data/tutor-history.json

# Fila persistente e auditável de automações assistidas. Nenhuma proposta é executada pela API.
AUTOMATION_PROPOSALS_FILE=./data/automation-proposals.json

# Backups isolados por campanha. Arquivos .mobackup e snapshots pré-restauração ficam fora do Git.
BACKUP_DIRECTORY=./data/backups
BACKUP_RETENTION_PER_CAMPAIGN=20
