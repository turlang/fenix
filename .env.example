PORT=3001
HOST=0.0.0.0
NODE_ENV=development
BODY_LIMIT_BYTES=2097152
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:30000,http://127.0.0.1:30000,http://localhost:3000,http://localhost:3001

# Configure ao menos um provedor com chave e modelo. Sem nenhum provedor completo, o Engine retorna AI_NOT_CONFIGURED.
# Groq permanece como primeira opção no exemplo, mas não é obrigatória.
GROQ_API_KEY=
GROQ_MODEL=

# Histórico persistente usado pelo NoveltyGuard para evitar repetir aberturas.
# Opcional. Padrão: ./data/narration-history.json
MESTRE_ORC_NARRATION_MEMORY_FILE=./data/narration-history.json

# Memória persistente da campanha: fatos, NPCs, relações, missões, itens e World State.
# Opcional. Padrão: ./data/campaign-memory.json
MESTRE_ORC_CAMPAIGN_MEMORY_FILE=./data/campaign-memory.json

# Biblioteca persistente de aventuras importadas.
# Opcional. Padrão: ./data/adventure-library.json
ADVENTURE_LIBRARY_FILE=./data/adventure-library.json

# Comando opcional para extração de PDF textual.
# Linux/macOS normalmente usam pdftotext; no Windows informe o caminho do executável do Poppler quando necessário.
PDFTOTEXT_COMMAND=pdftotext

# Áudio da narração. O modo browser-tts envia uma diretiva ao módulo Foundry;
# cada navegador converte o roteiro em voz, interpreta marcações expressivas e preserva pausas dramáticas.
MESTRE_ORC_AUDIO_ENABLED=true
MESTRE_ORC_AUDIO_MODE=browser-tts
MESTRE_ORC_AUDIO_LANGUAGE=pt-BR
MESTRE_ORC_AUDIO_RATE=0.90
MESTRE_ORC_AUDIO_PITCH=0.85
MESTRE_ORC_AUDIO_VOLUME=1.00

# Resiliência de IA. Configure dois ou mais provedores para fallback automático.
# A ordem abaixo define o primário e os fallbacks; provedores configurados e omitidos são anexados ao final.
AI_PROVIDER_ORDER=groq,openai,anthropic,compatible
AI_PROVIDER_TIMEOUT_MS=45000
AI_PROVIDER_FAILURE_THRESHOLD=3
AI_PROVIDER_COOLDOWN_MS=60000

# Groq — Chat Completions compatível com OpenAI.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI — Responses API. Configure somente quando desejar usar este provedor.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic — Messages API. Configure somente quando desejar usar este provedor.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01

# Endpoint adicional compatível com OpenAI, inclusive servidor local.
# A chave pode permanecer vazia quando o servidor não exigir autenticação.
AI_COMPATIBLE_ID=local
AI_COMPATIBLE_API_KEY=
AI_COMPATIBLE_MODEL=
AI_COMPATIBLE_BASE_URL=
AI_COMPATIBLE_MAX_TOKENS_FIELD=max_tokens
