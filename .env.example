PORT=3001
HOST=0.0.0.0
NODE_ENV=development
BODY_LIMIT_BYTES=2097152
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:30000,http://127.0.0.1:30000,http://localhost:3000,http://localhost:3001

# Persistência do Fênix.
# Sem DATABASE_URL, o desenvolvimento continua usando JSON local.
# Em produção, prefira postgres para campanhas/sessões simultâneas e persistência transacional.
FENIX_PERSISTENCE_DRIVER=json
FENIX_STATE_FILE=./data/fenix-state.json
# DATABASE_URL=postgres://usuario:senha@host:5432/fenix
# FENIX_PERSISTENCE_DRIVER=postgres
FENIX_POSTGRES_POOL_MAX=10
FENIX_POSTGRES_CONNECT_TIMEOUT_MS=5000
FENIX_POSTGRES_IDLE_TIMEOUT_MS=30000

# Assets de mapas do VTT standalone.
FENIX_ASSET_DIR=./data/fenix-assets
FENIX_ASSET_MAX_BYTES=15728640

# Importação de battlemap por URL HTTP/HTTPS.
FENIX_REMOTE_MAP_TIMEOUT_MS=10000
FENIX_REMOTE_MAP_MAX_REDIRECTS=3

# Coordenação distribuída (ativa somente com PostgreSQL).
# FENIX_INSTANCE_ID=engine-render-1
# FENIX_INSTANCE_PUBLIC_URL=https://engine-a.internal.example.com
# FENIX_INTERNAL_ROUTING_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
FENIX_RUNTIME_LEASE_TTL_MS=15000
FENIX_RUNTIME_HEARTBEAT_MS=5000
FENIX_RUNTIME_RECONCILE_MS=5000
FENIX_RUNTIME_ROUTING_TIMEOUT_MS=5000
FENIX_RUNTIME_ROUTING_MAX_RETRIES=1

# Ledger distribuído de comandos.
FENIX_COMMAND_LEDGER_WAIT_MS=1500
FENIX_COMMAND_LEDGER_UNKNOWN_AFTER_MS=60000
FENIX_COMMAND_LEDGER_RETENTION_HOURS=168
FENIX_COMMAND_LEDGER_RESULT_MAX_BYTES=524288

# Cookie HttpOnly de autenticação standalone.
FENIX_AUTH_COOKIE_SAME_SITE=Lax

# Compatibilidade do módulo Foundry/HTTP legado.
FENIX_ALLOW_LEGACY_SESSION_HTTP=true

# -----------------------------------------------------------------------------
# AI Gateway híbrido
# -----------------------------------------------------------------------------
FENIX_AI_ROUTING_POLICY=local-preferred
# FENIX_LOCAL_LLM_BASE_URL=http://gpu-ai.internal:8000/v1
# FENIX_LOCAL_LLM_MODEL=seu-modelo-local
# FENIX_LOCAL_LLM_API_KEY=opcional_se_o_runtime_exigir
FENIX_LOCAL_LLM_TIMEOUT_MS=60000
FENIX_LOCAL_LLM_MAX_TOKEN_FIELD=max_tokens

GROQ_API_KEY=sua_chave_aqui
GROQ_MODEL=defina_um_modelo_disponivel_na_sua_conta_groq
# GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=45000

# -----------------------------------------------------------------------------
# Remote Render GPU / First Person — App Server
# -----------------------------------------------------------------------------
# FENIX_RENDER_NODE_URL=http://gpu-render.internal:9000
# FENIX_RENDER_NODE_ID=render-gpu-01
# FENIX_RENDER_NODE_TOKEN=troque-por-token-interno-forte
# FENIX_RENDER_NODE_REGION=br-1
FENIX_RENDER_NODE_PRIORITY=100
FENIX_RENDER_NODE_TIMEOUT_MS=10000

# URL do App Server acessível pelo processo 3D no servidor GPU.
# É usada SOMENTE para o canal server-to-server de input semântico do runtime.
# O broker cria controlId/token efêmeros por sessão; o processo não recebe cookie
# do jogador nem FENIX_RENDER_NODE_TOKEN.
# Em produção prefira URL privada/VPC/VPN quando App Server e GPU estiverem separados.
# FENIX_RENDER_CONTROL_BASE_URL=https://api-internal.seudominio.com

# -----------------------------------------------------------------------------
# Reference Render Node — processo executado no servidor GPU
# -----------------------------------------------------------------------------
# Suba com: npm run start:render-node
FENIX_RENDER_NODE_HOST=0.0.0.0
FENIX_RENDER_NODE_PORT=9000
FENIX_RENDER_NODE_CAPACITY=2
FENIX_RENDER_SESSION_TTL_MS=1800000
FENIX_RENDERER_KIND=unreal-pixel-streaming
# FENIX_RENDER_PLAYER_URL_TEMPLATE=https://stream.seudominio.com/player?renderSessionId={renderSessionId}&actorId={actorId}
# FENIX_RENDER_SIGNALLING_URL_TEMPLATE=wss://stream.seudominio.com/signalling/{renderSessionId}
FENIX_RENDER_NODE_PUBLIC_HEALTH=false

# Modo do runtime 3D:
# - external: o Render Node só aloca uma infraestrutura Pixel Streaming já executando.
# - process: uma aplicação Unreal empacotada é iniciada e supervisionada por sessão.
FENIX_RENDER_RUNTIME_MODE=external

# Para process mode, tudo abaixo existe APENAS no servidor GPU.
# O comando nunca é aceito do navegador ou do payload de sessão.
# Linux:
# FENIX_RENDER_RUNTIME_COMMAND=/opt/fenix3d/Fenix3D.sh
# FENIX_RENDER_RUNTIME_CWD=/opt/fenix3d
# Windows:
# FENIX_RENDER_RUNTIME_COMMAND=C:\Fenix3D\Fenix3D.exe
# FENIX_RENDER_RUNTIME_CWD=C:\Fenix3D
# URL WebSocket usada pelo executável Unreal para conectar ao Signalling Server.
# FENIX_RENDER_STREAMER_URL_TEMPLATE=ws://127.0.0.1:8888

# Endpoint local que o processo 3D usa para buscar o Runtime Manifest da sua sessão.
# Por padrão é http://127.0.0.1:<FENIX_RENDER_NODE_PORT>. O launcher injeta:
# - FENIX_RUNTIME_MANIFEST_URL
# - FENIX_RUNTIME_MANIFEST_TOKEN
# Os aliases FENIX_WORLD_BOOTSTRAP_* permanecem apenas durante a migração do runtime.
# FENIX_RENDER_RUNTIME_BOOTSTRAP_BASE_URL=http://127.0.0.1:9000

# O launcher também injeta, quando o App Server fornece o canal de controle:
# - FENIX_RUNTIME_CONTROL_ID
# - FENIX_RUNTIME_CONTROL_URL
# - FENIX_RUNTIME_CONTROL_TOKEN
# Esses valores são exclusivos da sessão e nunca são enviados ao browser.

# Argumentos extras são um array JSON; shell permanece desativado.
# Placeholders: {renderSessionId}, {campaignId}, {sessionId}, {sceneId}, {actorId},
# {tokenId}, {targetFps}, {maxWidth}, {maxHeight}.
# FENIX_RENDER_RUNTIME_EXTRA_ARGS_JSON=["-ResX={maxWidth}","-ResY={maxHeight}"]
FENIX_RENDER_RUNTIME_STARTUP_GRACE_MS=2500
FENIX_RENDER_RUNTIME_STOP_TIMEOUT_MS=5000

# Histórico persistente usado pelo NoveltyGuard para evitar repetir aberturas.
MESTRE_ORC_NARRATION_MEMORY_FILE=./data/narration-history.json

# Áudio da narração.
MESTRE_ORC_AUDIO_ENABLED=true
MESTRE_ORC_AUDIO_MODE=browser-tts
MESTRE_ORC_AUDIO_LANGUAGE=pt-BR
MESTRE_ORC_AUDIO_RATE=0.92
MESTRE_ORC_AUDIO_PITCH=0.95
MESTRE_ORC_AUDIO_VOLUME=1.00
# MESTRE_ORC_AUDIO_VOICE=Microsoft Antonio - Portuguese (Brazil)

MESTRE_ORC_AUDIO_EMOTION_MARKERS=false
