PORT=3001
HOST=0.0.0.0
NODE_ENV=development
BODY_LIMIT_BYTES=2097152
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:30000,http://127.0.0.1:30000,http://localhost:3000,http://localhost:3001

# Estado persistente de contas, sessões autenticadas, campanhas, convites e mundo realtime.
# O arquivo é escrito atomicamente e fica ignorado pelo Git. Em produção, monte este caminho
# em armazenamento persistente (por exemplo, Persistent Disk no Render).
FENIX_STATE_FILE=./data/fenix-state.json

# Cookie HttpOnly de autenticação standalone.
# Desenvolvimento/same-site: Lax. Em produção com Vercel + Render em sites diferentes, use None;
# NODE_ENV=production já usa None + Secure por padrão.
FENIX_AUTH_COOKIE_SAME_SITE=Lax

# Compatibilidade do módulo Foundry/HTTP legado.
# Development: true por padrão. Production: false por padrão.
# Ative explicitamente em produção apenas quando o adapter Foundry precisar chamar /v1/session/* sem cookie standalone.
FENIX_ALLOW_LEGACY_SESSION_HTTP=true

# Obrigatórios para publicar narrações. Sem estes campos, o Engine retorna AI_NOT_CONFIGURED.
GROQ_API_KEY=sua_chave_aqui
GROQ_MODEL=defina_um_modelo_disponivel_na_sua_conta_groq

# Histórico persistente usado pelo NoveltyGuard para evitar repetir aberturas.
# Opcional. Padrão: ./data/narration-history.json
MESTRE_ORC_NARRATION_MEMORY_FILE=./data/narration-history.json

# Áudio da narração. O modo browser-tts envia uma diretiva ao módulo Foundry;
# cada navegador converte o texto em voz usando uma voz local em português.
MESTRE_ORC_AUDIO_ENABLED=true
MESTRE_ORC_AUDIO_MODE=browser-tts
MESTRE_ORC_AUDIO_LANGUAGE=pt-BR
MESTRE_ORC_AUDIO_RATE=0.90
MESTRE_ORC_AUDIO_PITCH=0.85
MESTRE_ORC_AUDIO_VOLUME=1.00

# Mantém false enquanto o canal de saída for Browser-TTS/chat puro.
# Providers emocionais futuros poderão ativar os marcadores [calmo], [tenso],
# [sussurro], [urgente] e [pausa] sem alterar as regras narrativas do Core.
MESTRE_ORC_AUDIO_EMOTION_MARKERS=false
